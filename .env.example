# =============================================================
# .env.example
# Copy this file to .env and fill in your local values.
# .env is listed in .gitignore — never commit real secrets.
# =============================================================

# Flask environment: development | testing | production
APP_ENV=development

# A long, random string — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=college_cms

# (Optional) Separate DB used when APP_ENV=testing
MYSQL_TEST_DB=college_cms_test

# Port the dev server listens on
PORT=5000
